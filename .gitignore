# Test/prod runtime artifacts (never commit logs or binaries' leftovers)
*.log
*.exe~
goroutines.txt
cfg*.json
config-test*.txt
warp-test-*.exe
warptest*.exe

# Operator runtime override. The tracked reference is config.example.json;
# config.json is whatever this install actually runs with.
config.json

# Build output of the documented build-then-swap flow (a running .exe cannot be
# overwritten on Windows, so the new build lands under a separate name first).
warp-minimal-new.exe

# Local run artifacts
*.err
